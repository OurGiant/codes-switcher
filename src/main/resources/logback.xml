<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- STDOUT is kept deliberately, even though the packaged app is normally started via a
         double-clicked native installer rather than lived-in from a terminal: the FILE appender
         below is the durable record for that normal case, but this jar is also run directly with
         `java -jar` during development and manual troubleshooting, where console output is the
         quickest way to see logging live. There's no in-app "View Logs" menu item, so dropping
         STDOUT would leave that path with no immediate feedback at all. -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${user.home}/.codes-switcher/logs/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/.codes-switcher/logs/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
